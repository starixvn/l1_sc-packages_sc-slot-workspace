{
  "name": "sc-slot-board-statistic",
  "version": "2.0.0",
  "description": "Enhanced slot board statistics with MongoDB replica set, result chain verification, and simplified schema",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate-chains": "node --experimental-specifier-resolution=node --loader ts-node/esm src/scripts/generate-chains.ts",
    "verify-chain": "node --experimental-specifier-resolution=node --loader ts-node/esm src/scripts/verify-exploded-symbols.ts",
    "import-chains": "node --experimental-specifier-resolution=node --loader ts-node/esm src/scripts/import-chains.ts",
    "db:connect": "node --experimental-specifier-resolution=node --loader ts-node/esm tests/scripts/db-connect-test.ts",
    "cascading-slot": "node --experimental-specifier-resolution=node --loader ts-node/esm src/cascading-slot/statistic-reporter.ts",
    "test-simple": "node --experimental-specifier-resolution=node --loader ts-node/esm tests/test-patterns-simple.ts",
    "db:reset": "ts-node src/scripts/reset-database.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist"
  },
  "keywords": [
    "slot-machine",
    "board-generation",
    "statistics",
    "rtp-calculation",
    "player-analytics",
    "result-chains",
    "emotional-patterns",
    "mongodb",
    "mongoose"
  ],
  "author": "Slot Chain Team",
  "license": "MIT",
  "dependencies": {
    "sc-cascading-slot-base": "^2.0.0",
    "sc-slot-board-generator": "^1.2.0-beta.1",
    "ramda": "^0.29.1",
    "chance": "^1.1.11",
    "mongoose": "^7.6.3",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ramda": "^0.29.8",
    "@types/chance": "^1.1.6",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/sc-slot-workspace.git",
    "directory": "sc-slot-packages/libs/board/sc-slot-board-statistic"
  },
  "bugs": {
    "url": "https://github.com/your-org/sc-slot-workspace/issues"
  },
  "homepage": "https://github.com/your-org/sc-slot-workspace#readme",
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ]
}