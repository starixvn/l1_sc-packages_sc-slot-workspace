{
  "testConfiguration": {
    "description": "Configuration for emotional pattern testing",
    "version": "1.0.0",
    "presets": {
      "quick": {
        "chainLength": 50,
        "betSize": 1.0,
        "targetRTP": 0.97,
        "saveDetailedResults": false,
        "description": "Quick test for development and debugging"
      },
      "standard": {
        "chainLength": 125,
        "betSize": 1.0,
        "targetRTP": 0.97,
        "saveDetailedResults": true,
        "description": "Standard test for pattern validation (100-150 boards)"
      },
      "comprehensive": {
        "chainLength": 500,
        "betSize": 1.0,
        "targetRTP": 0.97,
        "saveDetailedResults": true,
        "description": "Comprehensive test for production validation"
      },
      "production": {
        "chainLength": 1000,
        "betSize": 1.0,
        "targetRTP": 0.97,
        "saveDetailedResults": true,
        "description": "Production-level testing with large sample size"
      }
    },
    "customization": {
      "supportedBetSizes": [0.1, 0.5, 1.0, 2.0, 5.0, 10.0],
      "supportedRTPTargets": [0.94, 0.95, 0.96, 0.97, 0.98],
      "supportedChainLengths": [25, 50, 100, 125, 150, 200, 500, 1000, 2000],
      "outputFormats": ["json", "csv", "markdown"],
      "metricsToTrack": [
        "RTP accuracy",
        "Feature trigger frequency",
        "Win distribution balance",
        "Emotional engagement score",
        "Pattern completion rate",
        "Execution performance"
      ]
    },
    "patternSpecificSettings": {
      "comeback": {
        "idealLossStreakLength": "3-5 rounds",
        "targetReliefMoments": "2-3 per pattern cycle",
        "rtpTolerance": 0.03
      },
      "cliffhanger": {
        "idealTensionBuildup": "4-6 rounds",
        "targetBigWinFrequency": "1 per pattern cycle",
        "rtpTolerance": 0.04
      },
      "discovery": {
        "idealFeatureTriggerRate": "15-20%",
        "targetExplorationPhase": "3-4 rounds",
        "rtpTolerance": 0.02
      },
      "tease": {
        "idealNearMissFrequency": "20-25%",
        "targetPayoffTiming": "After 3-4 near misses",
        "rtpTolerance": 0.03
      },
      "wave": {
        "idealRhythmCycles": "2-3 per pattern",
        "targetClimaxIntensity": "5x+ bet win",
        "rtpTolerance": 0.02
      }
    }
  },
  "validationCriteria": {
    "rtpAccuracy": {
      "excellent": "±1%",
      "good": "±3%",
      "acceptable": "±5%",
      "poor": ">±5%"
    },
    "engagementScore": {
      "excellent": "80-100",
      "good": "60-79",
      "acceptable": "40-59",
      "poor": "<40"
    },
    "featureTriggerBalance": {
      "optimal": "10-18%",
      "acceptable": "8-20%",
      "needs_adjustment": "<8% or >20%"
    },
    "winDistribution": {
      "bigWins": "5-15%",
      "mediumWins": "20-35%", 
      "smallWins": "25-40%",
      "losses": "45-65%"
    }
  }
}

