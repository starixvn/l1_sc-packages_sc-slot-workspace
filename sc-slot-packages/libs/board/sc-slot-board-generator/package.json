{
    "name": "sc-slot-board-generator",
    "version": "1.2.0-beta.1",
    "description": "Slot Board Generator",
    "main": "./lib/index.js",
    "typings": "./lib/index.d.ts",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix  && prettier --write '{src}/**/*.ts'",
        "prebuild": "rimraf lib",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "generate": "npx ts-node scripts/generate-predefined-results.ts",
        "generate:batch": "npx ts-node scripts/generate-predefined-results.ts --batch",
        "generate:demo": "npx ts-node scripts/generate-predefined-results.ts --boards 50 --rtp 0.97 --output demo-results.json --description \"Quick demo with 50 boards\"",
        "generate:help": "npx ts-node scripts/generate-predefined-results.ts --help",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "files": [
        "lib/"
    ],
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/sc-packages/sc-slot-board-generator.git"
    },
    "keywords": [
        "board-generator",
        "sc-slot-board-generator"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "license": "ISC",
    "dependencies": {
        "chance": "^1.1.7",
        "commander": "^14.0.0",
        "ramda": "^0.28.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@types/chance": "^1.1.3",
        "@types/jest": "^27.0.0",
        "@types/ramda": "^0.28.12",
        "babel-jest": "^27.0.0",
        "jest": "^27.0.0",
        "jest-extended": "^4.0.0",
        "jest-sonar-reporter": "^2.0.0",
        "rimraf": "^3.0.2",
        "ts-jest": "^27.1.4",
        "typescript": "^4.6.3"
    }
}
